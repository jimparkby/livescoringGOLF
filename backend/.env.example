DB_HOST=your-db-host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
JWT_SECRET=минимум_32_случайных_символа_сюда
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com
PORT=3001
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Admin access: comma-separated list of Telegram user IDs
ADMIN_TELEGRAM_IDS=940046481,1046311150
# Chat id of the club's results Telegram group (bot must be a member/admin
# there). Photos posted in this chat are auto-parsed as tournament results.
# Leave blank until you've added the bot to the group — its id will show up
# in the logs as "[bot] message from unconfigured group: <id> <title>".
RESULTS_GROUP_CHAT_ID=
# Proxy for Telegram API (required if server is in Russia/CIS):
# HTTP:   TELEGRAM_PROXY_URL=http://user:pass@host:port
# SOCKS5: TELEGRAM_PROXY_URL=socks5://user:pass@host:port
TELEGRAM_PROXY_URL=
