{
  "name": "golfminsk-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "prestart": "test -d ../frontend && (cd ../frontend && npm ci --prefer-offline && npm run build) && echo '[boot] frontend built' || echo '[boot] frontend skip'",
    "start": "node src/index.js",
    "start:bot": "node src/bot-standalone.js",
    "dev": "node --watch src/index.js",
    "import:hdid": "node scripts/import-hdid.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "pg": "^8.13.3",
    "socks-proxy-agent": "^10.0.0"
  }
}
